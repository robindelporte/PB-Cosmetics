<div class="padding-global">
          <div class="padding-section-medium">
            <div class="container-large">
              <div x-data="storeLocator()" class="pdv_component">
                <div class="pdv_search-wrapper"><input placeholder="Code postal, ville" type="text" x-model="search" x-on:keydown.enter="findNearest()" class="search_input"><button x-on:click="findNearest()" type="button" class="button is-search">
                    <div class="button_text is-alternate">
{{ section.settings.text_texte }}
</div>
                    <div class="button_overlay is-alternate"></div>
                  </button></div>
                <div class="pdv_list-wrapper">
                  <div class="pdv_list"><template x-for="store in sortedStores" :key="store.id">
                      <div class="pdv_item">
                        <div class="pdv_item-content">
                          <div x-text="store.nom" class="text-weight-semibold text-size-medium">Point de vente numéro 1</div>
                          <div class="pdv_item-content-adress">
                            <div x-text="store.adresse" class="text-color-grey">Exemple d’adresse</div>
                            <div class="pdv_item-content-adress-city">
                              <div x-text="store.ville" class="text-color-grey">Lyon</div>
                              <div x-text="store.code_postal" class="text-color-grey">69001</div>
                            </div>
                            <div x-text="store.pays" class="text-color-grey">France</div>
                          </div>
                          <div x-text="store.horaires" class="text-weight-semibold">10h - 20h</div>
                        </div><img src="../images/platzhalter.svg" loading="lazy" :src="store.image" alt="" class="pdv_item-image">
                      </div>
                    </template></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="hide w-embed w-script">
          <script>
function storeLocator() {
  return {
    search: '',
    stores: [
      {% for store in shop.metaobjects.point_de_vente.values %}
      {
        id: {{ forloop.index }},
        nom: "{{ store.nom | escape }}",
        adresse: "{{ store.adresse | escape }}",
        ville: "{{ store.ville | escape }}",
        code_postal: "{{ store.code_postal | escape }}",
        pays: "{{ store.pays | default: 'France' | escape }}",
        horaires: "{{ store.horaires | escape }}",
        image: "{{ store.image | image_url: width: 400 }}",
        lat: {{ store.latitude | default: 0 }},
        lng: {{ store.longitude | default: 0 }},
        distance: null
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    sortedStores: [],
    init() {
      this.sortedStores = this.stores;
    },
    async findNearest() {
      if (!this.search) {
        this.sortedStores = this.stores;
        return;
      }
      try {
        const response = await fetch(
          `https://api-adresse.data.gouv.fr/search/?q=${encodeURIComponent(this.search)}&limit=1`
        );
        const data = await response.json();
        if (data.features.length === 0) {
          // Fallback : filtre local sur ville ou code postal
          const searchLower = this.search.toLowerCase();
          this.sortedStores = this.stores.filter(store => 
            store.ville.toLowerCase().includes(searchLower) || 
            store.code_postal.includes(this.search)
          );
          return;
        }
        const [lng, lat] = data.features[0].geometry.coordinates;
        this.stores.forEach(store => {
          if (store.lat && store.lng) {
            store.distance = this.calculateDistance(lat, lng, store.lat, store.lng);
          }
        });
        this.sortedStores = [...this.stores].sort((a, b) => {
          if (a.distance === null) return 1;
          if (b.distance === null) return -1;
          return a.distance - b.distance;
        });
      } catch (error) {
        console.error('Erreur de g&eacute;ocodage:', error);
        // Fallback en cas d'erreur r&eacute;seau
        const searchLower = this.search.toLowerCase();
        this.sortedStores = this.stores.filter(store => 
          store.ville.toLowerCase().includes(searchLower) || 
          store.code_postal.includes(this.search)
        );
      }
    },
    calculateDistance(lat1, lng1, lat2, lng2) {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLng = (lng2 - lng1) * Math.PI / 180;
      const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLng/2) * Math.sin(dLng/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      return Math.round(R * c);
    }
  }
}
</script>
        </div> {% schema %} {
    "tag": "div",
    "name": "Point de vente",
    "class": "section_pdv",
    "settings": [
        {
            "id": "text_texte",
            "type": "text",
            "label": "Texte",
            "default": "REchercher"
        }
    ],
    "presets": [
        {
            "name": "Point de vente",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}