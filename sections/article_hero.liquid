{% assign words = article.content | strip_html | split: ' ' | size %}
        {% assign minutes = words | divided_by: 200 | at_least: 1 %}
        <div class="padding-global">
          <div class="padding-section-small">
            <div class="container-large">
              <div class="article-hero_component">
                <div class="article-hero_heading">
                  <h1 li-object="article.title" class="article_heading">{{ article.title }}</h1>
                  <div class="article-hero_heading-details hide-tablet">
                    <div class="article-hero_heading-details-item">
                      <div>Auteur :</div>
                      <div li-object="article.author">{{ article.author }}</div>
                    </div>
                    <div class="article-hero_heading-details-item">
                      <div>Lecture :</div>
                      <div li-object="minutes | append: ' MIN'">{{ minutes | append: ' MIN' }}</div>
                    </div>
                    <div class="article-hero_heading-details-item">
                      <div>Publié le</div>
                      <div li-object="article.published_at | date: '%d %B %Y'">{{ article.published_at | date: '%d %B %Y' }}</div>
                    </div>
                  </div>
                </div>
                <div class="article-hero_image-wrapper"><img class="article-hero_image" src="{{ article.image | image_url: width: 1000 }}" alt="{{ article.image.alt }}" sizes="100vw" li-object:src="article.image | image_url: width: 1000" loading="lazy" li-object:alt="article.image.alt" srcset="{{ 'hero-1-p-500.avif' | asset_url }} 500w, {{ 'hero-1-p-800.avif' | asset_url }} 800w, {{ 'hero-1-p-1080.avif' | asset_url }} 1080w, {{ 'hero-1.avif' | asset_url }} 2880w">
                  <div class="article-hero_heading-details hide-desktop">
                    <div class="article-hero_heading-details-item">
                      <div>Auteur :</div>
                      <div li-object="article.author">{{ article.author }}</div>
                    </div>
                    <div class="article-hero_heading-details-item">
                      <div>Lecture :</div>
                      <div li-object="minutes | append: ' MIN'">{{ minutes | append: ' MIN' }}</div>
                    </div>
                    <div class="article-hero_heading-details-item">
                      <div>Publié le</div>
                      <div li-object="article.published_at | date: '%d %B %Y'">{{ article.published_at | date: '%d %B %Y' }}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Article Hero",
    "class": "section_article-hero",
    "presets": [
        {
            "name": "Article Hero",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "article"
        ]
    }
} {% endschema %}