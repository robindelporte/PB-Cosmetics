                        <path fill="currentColor" d="m29 27.586l-7.552-7.552a11.018 11.018 0 1 0-1.414 1.414L27.586 29ZM4 13a9 9 0 1 1 9 9a9.01 9.01 0 0 1-9-9Z"></path>
                      </svg></div>
                  </button>
                  <div class="cart_headline">
                    <h1 class="heading-style-h3">VOTRE PANIER</h1>
                    <a li-object:href="routes.root_url" href="{{ routes.root_url }}" class="cart_headline-link">Retour à la boutique</a>
                  </div>
                </div>
                {% if cart.item_count > 0 %}    <div li-if="cart.item_count > 0" class="cart_component w-form">
    
                  {% form 'cart', cart, class: 'cart_form' %}
<div class="cart_grid-wrapper">
                      <div class="cart_grid">
                        <div class="cart_grid-heading">
                          <div>Produit</div>
                          <div class="hide-tablet">Prix</div>
                          <div class="hide-tablet">Quantité</div>
                          <div id="w-node-ed10e967-910f-edf9-2343-a60029c8d457-50b9d2b5">Total</div>
                        </div>
                        {% for item in cart.items %}    <div li-for="item in cart.items" class="cart_grid-row">
                                    
                          
                            <div class="cart_product-wrapper">
                            <a li-object:href="item.url" href="{{ item.url }}" class="w-inline-block"><img class="cart_product-image" src="{{ item.image | image_url: width: 200 }}" alt="" sizes="(max-width: 1468px) 100vw, 1468px" li-object:src="item.image | image_url: width: 200" loading="lazy" srcset="{{ 'parfum-3-p-500.avif' | asset_url }} 500w, {{ 'parfum-3-p-800.avif' | asset_url }} 800w, {{ 'parfum-3.avif' | asset_url }} 1468w"></a>
                            <div class="cart_product-content">
                              <a li-object:href="item.url" li-object="item.title" href="{{ item.url }}" class="text-style-allcaps">{{ item.title }}</a>
                              <div li-object="item.product.metafields.custom.texte_sous_titre" class="text-size-tiny text-color-contraste text-style-allcaps">{{ item.product.metafields.custom.texte_sous_titre }}</div>
                              <div class="cart_product-variant">
                                {% if item.variant.metafields.custom.couleur_code %}    <div li-if="item.variant.metafields.custom.couleur_code" class="cart_product-variant-swatch">
        </div>
{% endif %}
                                <div li-object="item.variant.title" class="text-size-tiny">{{ item.variant.title }}</div>
                              </div>
                              <div class="mini-cart_item-quantity hide-desktop"><button type="button" cart-number-button="decrease" data-id="cart-item-{{ item.variant_id }}" class="mini-cart_item-quantity-adjust">
                                  <div aria-hidden="true" class="icon-1x1-xxxsmall w-embed"><svg width="10" height="11" viewbox="0 0 10 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                                      <path d="M0.0654297 5.49414H9.5752" stroke="#1C1F31" stroke-width="0.780288"></path>
                                    </svg></div>
                                </button><input li-element="mini-cart-item-quantity" type="text" min="1" li-object:value="item.quantity" name="updates[]" cart-number-input="cart-item-{{ item.variant_id }}" class="mini-cart_item-quantity-adjust is-input" value="item.quantity" :productprop="product" @input="$dispatch('setcartitem', { product: product.key, quantity: product.quantity })" x-model="product.quantity"><button li-element="mini-cart-item-increase" aria-label="Augmenter la quantité" class="mini-cart_item-quantity-adjust" :productprop="product" @click="$dispatch('increasecartitem', { product: product.key, quantity: product.quantity, action: 'increase' })">
                                  <div aria-hidden="true" class="icon-1x1-xxxsmall w-embed"><svg width="11" height="11" viewbox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                                      <path d="M0.555664 5.49414H10.0654" stroke="#1C1F31" stroke-width="0.780288"></path>
                                      <path d="M5.31055 10.249L5.31055 0.739258" stroke="#1C1F31" stroke-width="0.780288"></path>
                                    </svg></div>
                                </button></div>
                            </div>
                          </div>
                            
                          
                            <div class="cart_price-wrapper hide-tablet">
                            <div x-text="(() => { const price = item.price; const rate = 0.20; const centsHT = Math.round(price / (1 + rate)); return LiquifyHelper.moneyFormat(centsHT, true, '{{ shop.money_format }}') + ' HT';})()" li-object="item.price | money">{{ item.price | money }}</div>
                            {% if item.original_price > item.price %}    <div li-if="item.original_price > item.price">
    
                              <div x-text="(() => { const price = item.original_price; const rate = 0.20; const centsHT = Math.round(price / (1 + rate)); return LiquifyHelper.moneyFormat(centsHT, true, '{{ shop.money_format }}') + ' HT';})()" li-object="item.original_price | money" class="text-style-strikethrough text-color-grey-bordure">{{ item.original_price | money }}</div>
                                </div>
{% endif %}
                          </div>
                            
                          
                            <div id="w-node-ed10e967-910f-edf9-2343-a60029c8d471-50b9d2b5" class="cart_quantity-wrapper hide-tablet">
                            <div class="mini-cart_item-quantity"><button type="button" cart-number-button="decrease" data-id="cart-item-{{ item.variant_id }}" class="mini-cart_item-quantity-adjust">
                                <div aria-hidden="true" class="icon-1x1-xxxsmall w-embed"><svg width="10" height="11" viewbox="0 0 10 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M0.0654297 5.49414H9.5752" stroke="#1C1F31" stroke-width="0.780288"></path>
                                  </svg></div>
                              </button><input type="text" min="1" li-object:value="item.quantity" name="updates[]" cart-number-input="cart-item-{{ item.variant_id }}" class="mini-cart_item-quantity-adjust is-input" value="{{ item.quantity }}"><button aria-label="Augmenter la quantité" data-id="cart-item-{{ item.variant_id }}" cart-number-button="increase" class="mini-cart_item-quantity-adjust">
                                <div aria-hidden="true" class="icon-1x1-xxxsmall w-embed"><svg width="11" height="11" viewbox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M0.555664 5.49414H10.0654" stroke="#1C1F31" stroke-width="0.780288"></path>
                                    <path d="M5.31055 10.249L5.31055 0.739258" stroke="#1C1F31" stroke-width="0.780288"></path>
                                  </svg></div>
                              </button></div>
                          </div>
                            
                          
                            <div id="w-node-ed10e967-910f-edf9-2343-a60029c8d478-50b9d2b5" class="cart_price-total-row">
                            <div class="cart_price-total-row-item">
                              <div x-text="(() => { const price = item.final_line_price; const rate = 0.20; const centsHT = Math.round(price / (1 + rate)); return LiquifyHelper.moneyFormat(centsHT, true, '{{ shop.money_format }}') + ' HT';})()" li-object="item.final_line_price | money">{{ item.final_line_price | money }}</div>
                              <div x-text="(() => { const price = item.original_line_price; const rate = 0.20; const centsHT = Math.round(price / (1 + rate)); return LiquifyHelper.moneyFormat(centsHT, true, '{{ shop.money_format }}') + ' HT';})()" li-object="item.original_line_price | money" class="text-style-strikethrough text-color-grey-bordure">{{ item.original_line_price | money }}</div>
                            </div>
                            <a li-object:href="item.url_to_remove" href="{{ item.url_to_remove }}" class="cart_delete-row">Supprimer</a>
                          </div>
                            
                        
                        </div>
{% endfor %}
                      </div>
                      <div class="cart_summary-wrapper">
                        <div class="cart_subtotal-wrapper">
                          {% if cart.total_discount > 0 %}    <div li-if="cart.total_discount > 0" class="cart_details">
    
                            <div>Réductions</div>
                            <div x-text="(() => { const price = cart.total_discount; const rate = 0.20; const centsHT = Math.round(price / (1 + rate)); return LiquifyHelper.moneyFormat(centsHT, true, '{{ shop.money_format }}') + ' HT';})()" li-object="cart.total_discount | money">{{ cart.total_discount | money }}</div>
                              </div>
{% endif %}
                          <div class="cart_details">
                            <div>SOUS TOTAL</div>
                            <div x-text="(() => { const price = cart.total_price; const rate = 0.20; const centsHT = Math.round(price / (1 + rate)); return LiquifyHelper.moneyFormat(centsHT, true, '{{ shop.money_format }}') + ' HT';})()" li-object="cart.total_price | money">{{ cart.total_price | money }}</div>
                          </div>
                        </div>
                        <div class="text-size-small text-align-right">Taxes & frais de livraison calculés à la prochaine étape</div>
                        <div class="margin-top margin-custom1"><button class="button is-alternate is-checkout" name="checkout" value="Valider mon panier">
                            <div class="button_text is-alternate" name="Valider mon panier">Valider mon panier</div>
                            <div class="button_overlay is-alternate"></div>
                          </button></div>
                      </div>
                    </div>
                  {% endform %}
                  <div class="hide w-form-done">
                    <div>Thank you! Your submission has been received!</div>
                  </div>
                  <div class="hide w-form-fail">
                    <div>Oops! Something went wrong while submitting the form.</div>
                  </div>
                    </div>
{% endif %}
                {% if cart.item_count == 0 %}    <div li-if="cart.item_count == 0" class="empty_cart">
    
                  <div class="heading-style-h2 text-font-heading">TON PANIER EST VIDE</div>
                  <a href="{{ section.settings.url_routesroot_url }}" class="button w-inline-block"> <div class="button_text">{{ section.settings.text_texte }}</div> <div class="button_overlay"></div> </a>
                    </div>
{% endif %}
              </div>
            </div>
          </div>
        </div>
        <div class="hide w-embed w-script">
          <script>
document.addEventListener('DOMContentLoaded', function() {
    let isUpdating = false;
    let quantityUpdateTimeout = null;
    // &Agrave; REMPLACER APR&Egrave;S EXPORT avec le vrai section_id
    const CART_SECTION_ID = 'template--XXXXX__cart';
    function updateCartSection() {
        if (isUpdating) return;
        isUpdating = true;
        fetch(window.location.pathname + '?section_id=' + CART_SECTION_ID)
            .then(res => res.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newSection = doc.querySelector('#shopify-section-' + CART_SECTION_ID);
                const currentSection = document.querySelector('#shopify-section-' + CART_SECTION_ID);
                if (currentSection && newSection) {
                    currentSection.outerHTML = newSection.outerHTML;
                    initializeQuantityButtons();
                    // Sync avec mini-cart Liquify
                    fetch('/cart.js')
                        .then(r => r.json())
                        .then(cartData => {
                            window.dispatchEvent(new CustomEvent('carttotalitems', { 
                                detail: cartData.item_count 
                            }));
                            window.dispatchEvent(new CustomEvent('currentcartitems', { 
                                detail: cartData.items 
                            }));
                        });
                }
                isUpdating = false;
            })
            .catch(() => {
                isUpdating = false;
                location.reload();
            });
    }
    function initializeQuantityButtons() {
        const quantityInputs = document.querySelectorAll('[cart-number-input]');
        function updateInputValue(input, newValue) {
            input.value = newValue;
            if (quantityUpdateTimeout) {
                clearTimeout(quantityUpdateTimeout);
            }
            quantityUpdateTimeout = setTimeout(() => {
                const form = input.closest('form');
                if (form) {
                    const formData = new FormData(form);
                    fetch('/cart', {
                        method: 'POST',
                        body: formData
                    })
                    .then(() => updateCartSection())
                    .catch(() => form.submit());
                }
            }, 800);
        }
        quantityInputs.forEach(input => {
            const id = input.getAttribute('cart-number-input');
            const incrementButton = input.parentElement.querySelector(`[cart-number-button="increase"][data-id="${id}"]`);
            const decrementButton = input.parentElement.querySelector(`[cart-number-button="decrease"][data-id="${id}"]`);
            if (incrementButton) {
                incrementButton.replaceWith(incrementButton.cloneNode(true));
                const newIncrementButton = input.parentElement.querySelector(`[cart-number-button="increase"][data-id="${id}"]`);
                newIncrementButton.addEventListener('click', function() {
                    let currentValue = parseInt(input.value, 10);
                    updateInputValue(input, currentValue + 1);
                });
            }
            if (decrementButton) {
                decrementButton.replaceWith(decrementButton.cloneNode(true));
                const newDecrementButton = input.parentElement.querySelector(`[cart-number-button="decrease"][data-id="${id}"]`);
                newDecrementButton.addEventListener('click', function() {
                    let currentValue = parseInt(input.value, 10);
                    if (currentValue > 1) {
                        updateInputValue(input, currentValue - 1);
                    }
                });
            }
        });
    }
    // Gestion du bouton supprimer
    document.addEventListener('click', function(e) {
        const removeLink = e.target.closest('a[href*="cart/change"]');
        if (removeLink) {
            e.preventDefault();
            const removeUrl = removeLink.getAttribute('href');
            fetch(removeUrl)
                .then(() => updateCartSection())
                .catch(() => window.location.href = removeUrl);
        }
    });
    initializeQuantityButtons();
    window.updateCartSection = updateCartSection;
});
</script>
        </div> {% schema %} {
    "tag": "section",
    "name": "Panier",
    "class": "section_cart",
    "settings": [
        {
            "id": "url_routesroot_url",
            "type": "url",
            "label": "routes.root_url"
        },
        {
            "id": "text_texte",
            "type": "text",
            "label": "Texte",
            "default": "Retour a la boutique"
        }
    ],
    "presets": [
        {
            "name": "Panier",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "cart"
        ]
    }
} {% endschema %}