                        <path d="M0 1.40625V0H4.42969V1.40625H0Z" fill="currentColor"></path>
                      </svg></div>
                    <div class="hero-product_breadcrumbs-links">
                      <div>PANIER</div>
                    </div>
                  </div><button aria-label="{{ 'aria_labels.open_search' | t }}" x-bind:aria-expanded="showSearch" aria-controls="predictive-search-wrap" x-on:click="menu = 0; menuOpen = false; showSearch = true; setTimeout(() => {document.querySelector('[data-predictive-search-input]')?.focus()}, 500);" class="pro_search">
