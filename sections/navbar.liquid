                        <div class="script-js w-embed w-script">
                          <script>
document.addEventListener('alpine:init', () => {
  Alpine.data('handleUpsells', () => ({
    activeUpsells: [],
    async fetchProduct(handle) {
      try {
        const response = await fetch('/products/' + handle + '.js');
        if (response.ok) {
          return await response.json();
        }
      } catch (error) {
        console.error('Erreur fetch produit:', error);
      }
      return null;
    },
    async updateUpsells() {
      const miniCartEl = document.querySelector("[li-element='mini-cart']");
      let data = Alpine.$data(miniCartEl);
      if (data && data.cart && data.cart.items) {
        this.activeUpsells = [];
        const cartItems = data.cart.items;
        const cartVariantIds = cartItems.map(item => parseInt(item.variant_id || item.id));
        // R&eacute;cup&eacute;rer les handles des upsells depuis les properties
        const upsellHandles = cartItems
          .map(item => item.properties?._upsell_handle)
          .filter(Boolean);
        // Supprimer les doublons
        const uniqueHandles = [...new Set(upsellHandles)];
        // Fetch chaque produit upsell
        for (const handle of uniqueHandles) {
          const product = await this.fetchProduct(handle);
          if (product && !cartVariantIds.includes(product.variants[0].id)) {
            this.activeUpsells.push({
              id: product.variants[0].id,
              title: product.title,
              price: product.price,
              compareAtPrice: product.compare_at_price || product.price,
              imageSrc: product.featured_image,
              imageAlt: product.title,
              available: product.available,
              url: product.url,
              handle: product.handle
            });
          }
        }
        return data;
      }
    },
    async addUpsellToCart(variantId) {
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      });
      // Rafra&icirc;chir le panier
      document.dispatchEvent(new CustomEvent('liquify:cart-updated'));
      this.updateUpsells();
    },
    init() {
      setTimeout(() => { this.updateUpsells(); }, 1000);
      document.addEventListener('liquify:cart-updated', () => {
        setTimeout(() => { this.updateUpsells(); }, 500);
      });
    }
  }));
});
</script>
