{%- comment -%}
  Accepte: product (requis), variant (optionnel)
  Si variant n'est pas passé, fallback sur selected_or_first_available_variant
{%- endcomment -%}
{%- assign v = variant | default: product.selected_or_first_available_variant -%}
{%- assign pvc = product.metafields.custom.pvc.value -%}

<div x-data="{ min: {{ v.quantity_rule.min | default: 1 }}, max: {{ v.quantity_rule.max | default: 9999 }}, step: {{ v.quantity_rule.increment | default: 1 }}, quantity: {{ v.quantity_rule.min | default: 1 }} }" class="product-pro_item">
  <div class="product-pro_content">

    <div class="product-pro_image-wrapper">
      <img class="product-pro_image"
           src="{{ product.featured_image | image_url: width: 400 }}"
           alt="{{ product.featured_image.alt | default: product.title }}"
           srcset="{{ product.featured_image | image_url: width: 500 }} 500w, {{ product.featured_image | image_url: width: 800 }} 800w, {{ product.featured_image | image_url: width: 1468 }} 1468w"
           sizes="100vw"
           loading="lazy">
    </div>

    <div class="product-pro_infos">
      <div class="product-pro_heading">
        <div class="text-style-allcaps">{{ product.title }}</div>
        <div class="text-size-tiny text-style-allcaps text-color-grey">{{ v.sku }}</div>
        {% unless product.has_only_default_variant %}
          <div class="text-size-tiny text-style-allcaps">{{ v.title }}</div>
        {% endunless %}
      </div>

      <div class="product-pro_quantity">
        <div class="mini-cart_item-quantity">
          <button type="button" x-on:click="quantity = quantity > min ? quantity - step : min" class="mini-cart_item-quantity-adjust">−</button>
          <input type="text" name="updates[]" x-model="quantity" class="mini-cart_item-quantity-adjust is-input">
          <button type="button" x-on:click="quantity = quantity + step" class="mini-cart_item-quantity-adjust">+</button>
        </div>
        <div class="text-size-small text-color-grey" x-text="'produit vendu par ' + step"></div>
      </div>
    </div>

  </div>

  <div class="product-pro_buy">
    <div class="product-pro_buy-price">
      <p class="text-size-medium">{{ v.price | divided_by: 1.20 | money_without_currency }} € HT</p>
      {% if pvc %}
        <div class="text-size-small text-color-grey">Prix de vente conseillé : {{ pvc | money }} TTC</div>
      {% endif %}
    </div>

    {% form 'product', product, class: 'product-pro_buy-form' %}
      <input type="hidden" name="id" value="{{ v.id }}">
      <input type="hidden" name="quantity" x-bind:value="quantity">
      <input type="hidden" name="properties[_sous_titre]" value="{{ product.metafields.custom.texte_sous_titre }}">
      <input type="hidden" name="properties[_multiple]" value="{{ v.quantity_rule.increment | default: 1 }}">
      <input type="hidden" name="properties[_couleur_code]" value="{{ v.metafields.custom.couleur_code }}">
      <button type="submit" class="button is-search">AJOUTER AU PANIER</button>
    {% endform %}

  </div>
</div>