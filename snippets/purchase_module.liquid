{% assign first_variant = product.selected_or_first_available_variant %}
                <script src="{{ 'li_custom.js' | asset_url }}" type="text/javascript"></script>
<div x-init="$nextTick(() => { activateVariants() })" li-element="product-variant-container" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ product.selected_or_first_available_variant | json | escape }})" class="product-item_component is-lp" @setbundleitem.window="updateBundleItem($event.detail.product, $event.detail.quantity)">
                  <div class="product-item_image-link is-lp">
                    <div class="product-item_image-wrapper is-lp"><img width="191.5" height="800" alt="{{ product.featured_image.alt | default: product.title }}" src="{{ product.featured_image | image_url: width: 800, height: 800 }}" loading="lazy" li-object:alt="product.featured_image.alt | default: product.title" li-object:src="product.featured_image | image_url: width: 800, height: 800" class="product-item_image is-lp"></div>
                  </div>
                  <div class="product-item_content-wrapper is-lp">
                    <div class="product-item_heading">
                      <a li-object:href="product.url" href="{{ product.url }}" class="product-item_text-link w-inline-block">
                        <div class="product-item_left">
                          <div li-object="product.title" class="product_item-name">{{ product.title }}</div>
                        </div>
                        <div class="product-item_price">
                          <div li-object="product.price | money">{{ product.price | money }}</div>
                          {% if product.compare_at_price_max > product.price %}    <div li-if="product.compare_at_price_max > product.price">
    
                            <div li-object="product.compare_at_price | money" class="text-style-strikethrough text-style-muted">{{ product.compare_at_price | money }}</div>
                              </div>
{% endif %}
                        </div>
                      </a>
                    </div>
                    <div class="product-item_variant-wrapper">
                      <div li-object="product.metafields.custom.texte_sous_titre" class="product_item-tagline">{{ product.metafields.custom.texte_sous_titre }}</div>
                      {% if product.has_only_default_variant != true %}    <div li-if="product.has_only_default_variant != true">
    
                        <div class="product-item_radio-list">
                          {% for option in product.options_with_values %}    <div li-for="option in product.options_with_values">
                                    
                            
                            {% if option.name == 'Couleur' %}    <div li-if="option.name == 'Couleur'">
    
                              <div li-for:inside="value in option.values">
        {% for value in option.values %}                            <button x-on:click="open = true" type="button" class="product-item_radio is-lp" style="'background-color:' | append: value.variant.metafields.custom.couleur_code"></button>
                    {% endfor %}    </div>
                                </div>
{% endif %}
                            
                          
                        </div>
{% endfor %}{% if product.options_with_values[0].values.size > 4 %}    <button type="button" li-if="product.options_with_values[0].values.size > 4" x-on:click="open = true" class="product-item_radio is-plus">
    <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 25 25" fill="none" class="product-item_radio-plus">
                              <rect x="0.67094" y="0.67094" width="23.6581" height="23.6581" rx="11.8291" stroke="currentColor" stroke-width="1.34188"></rect>
                              <path d="M16.6527 13.0933H13.0934V16.6525H11.9069V13.0933H8.34766V11.9068H11.9069V8.34753H13.0934V11.9068H16.6527V13.0933Z" fill="currentColor"></path>
                            </svg>    </button>
{% endif %}
                        </div>
                          </div>
{% endif %}
                      {% if product.metafields.custom.parfum_tags %}    <div li-if="product.metafields.custom.parfum_tags">
    
                        {% assign parfum_tags = product.metafields.custom.parfum_tags.value %}
                        <div li-for:inside="tag in parfum_tags" class="product-item_tags">
        {% for tag in parfum_tags %}                            
                          
                            <div li-object="tag.senteur" class="product-snippet_tag">{{ tag.senteur }}</div>
                            
                        
                    {% endfor %}    </div>
                          </div>
{% endif %}
                    </div>
                  </div>
                  <div class="product-item_buttons is-lp">
                    {% if product.has_only_default_variant != true and product.available == true %}    <div li-if="product.has_only_default_variant != true and product.available == true" class="product-item_button">
    <button type="button" x-on:click="open = true" class="button is-product-card">
                        <div class="button_text is-product-card">Choisir ma couleur</div>
                        <div class="button_overlay"></div>
                      </button>    </div>
{% endif %}
                    {% if product.has_only_default_variant == true and product.available == true %}    <div li-if="product.has_only_default_variant == true and product.available == true" class="product-item_button">
    
                      <a li-element="add-to-cart" href="#" class="button is-product-card w-inline-block" @click="addToCart($event, true)" :disabled="!addToCartButton">
                        <div class="button_text is-product-card">AJOUTER AU PANIER</div>
                        <div class="button_overlay"></div>
                      </a>
                        </div>
{% endif %}
                    {% if product.available != true %}    <div li-if="product.available != true" class="product-item_button">
    
                      <a href="#" class="button is-secondary pointer-events-off max-width-full is-out-of-stock w-button">Rupture de stock</a>
                        </div>
{% endif %}
                  </div>
                  <div x-cloaks="" class="purchase-module_component">
                    <div class="purchase-module_wrap">
                      <div x-bind:class="{'is-open': open}" x-on:click="open = false" class="purchase-module_component-close"></div>
                      <div class="purchase-module_content">
                        {% form 'product', product, class: 'purchase-module_form' %}
<div x-bind:class="{'is-open': open}" class="purchase-module_product"><img x-bind:alt="selected_or_first_available_variant.title || '{{ product.title }}'" class="purchase-module_image" src="{{ product.featured_image | image_url: width: 250 }}" alt="{{ product.featured_image.alt | default: product.title }}" x-bind:class="{'is-open': open}" li-object:src="product.featured_image | image_url: width: 250" loading="lazy" x-bind:src="selected_or_first_available_variant.featured_image || '{{ product.featured_image | image_url: width: 250 }}'" li-object:alt="product.featured_image.alt | default: product.title">
                            <div class="purchase-module_infos">
                              <style>{% for variant in product.variants %}{% for option in variant.options %}#{{option | handleize}}{background-color:{{variant.metafields.custom.couleur_code}};}{% endfor %}{% endfor %}</style>
                              <div x-bind:class="{'is-open': open}" class="purchase-module_product-heading">
                                <div li-object="product.title" class="quick-buy_product-title">{{ product.title }}</div>
                                <div class="quick-buy_product-details">
                                  <div x-text="LiquifyHelper.moneyFormat(selected_or_first_available_variant.price)" li-object="product.price | money" class="quick-buy_product-price">{{ product.price | money }}</div>
                                  <div class="quick-buy_product-size">7ml</div>
                                </div>
                              </div>
                              <div x-bind:class="{'is-open': open}" class="purchase-module_variant-wrapper">
                                {% if product.has_only_default_variant != true %}    <div li-if="product.has_only_default_variant != true">
    
                                  <template x-for="(option, optionKey) in product.options" :key="optionKey">
    <div li-element="product-options-loop" class="product_option-loop" data-ProductVariantsLoop="true">
                                    <div class="product-hero_radio-list is-quickbuy"><template x-for="(variantName, variantKey) in options_by_name[option].option.values" :key="variantName">
    <label li-element="product-option-loop" class="product-hero_radio"><input type="radio" li-render-custom-trigger="input" li-render-custom-value="{{ product.url }}?section_id={{ section.id }}&variant={{ value.variant.id }}" x-on:change="setVariant" class="hide" {% if value.selected %}checked{% endif %} name="{{ option.name }}">
                                        <div class="product_variant-inner-circle" id="{{ value | handleize }}"></div>
                                        <div class="{% if value.selected %}is-active{% endif %}"></div>
                                      </label></template></div>
                                  </div></template>
                                    </div>
{% endif %}
                              </div>
                            </div>
                          </div>
                          <div class="hidden_fields"><input type="hidden" name="properties[_sous_titre]" value="product.metafields.custom.texte_sous_titre"><input type="hidden" name="properties[_couleur_code]" value="product.selected_or_first_available_variant.metafields.custom.couleur_code"><input type="hidden" name="properties[_upsell_id]" value="product.metafields.custom.produit_complementaire.value.selected_or_first_available_variant.id"><input type="hidden" name="properties[_upsell_handle]" value="product.metafields.custom.produit_complementaire.value.handle"></div><button type="button" li-element="add-to-cart" x-on:click="addToCart($event, true)" x-bind:disabled="!addToCartButton" x-bind:class="{'is-open': open}" class="purchase-module_atc" @click="addToCart($event, true)" :disabled="!addToCartButton">
                            <div class="button_text">AJOUTER AU PANIER</div>
                          </button>
                        {% endform %}<button aria-label="Fermer la sélection" x-on:click="open = false" type="button" aria-haspopup="dialog" x-bind:aria-expanded="open" x-bind:class="{'is-open': open}" class="purchase-module_close"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 27 27" fill="none" x-bind:class="{'is-open': open}" class="purchase-module_close-icon">
                            <path d="M11.9668 2.2537e-05V26.1085H14.1425V2.2537e-05H11.9668Z" fill="currentColor" class="purchase-module_close-icon-path"></path>
                            <path d="M26.1085 11.9664H0V14.1421H26.1085V11.9664Z" fill="currentColor"></path>
                          </svg></button>
                      </div>
                    </div>
                  </div>
                </div>
