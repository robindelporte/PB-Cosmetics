<div li-element="product-variant-container" class="quick-buy_wrap" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ product.selected_or_first_available_variant | json | escape }})" x-init="$nextTick(() => { activateVariants() })" @setbundleitem.window="updateBundleItem($event.detail.product, $event.detail.quantity)"><div class="quick-buy_form-wrapper w-form">{% form 'product', product, class: 'quick-buy_form' %}
