{% assign has_color_variants = false %}
                    {% for option in product.options_with_values %}{% if option.name == 'Couleur' and option.values.size > 1 %}{% assign has_color_variants = true %}{% endif %}{% endfor %}{% assign first_variant = product.selected_or_first_available_variant %}<div x-data="{ quickbuy: false }" class="product-item_wrapper"><div x-init="$nextTick(() => { activateVariants() })" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ first_variant | json | escape }})" class="product-item_component"><div class="product-item_image-link"><a li-object:href="product.url" href="{{ product.url }}" class="product-item_image-wrapper w-inline-block"><img width="191.5" height="800" alt="{{ product.featured_image.alt | default: product.title }}" src="{{ product.featured_image | image_url: width: 800, height: 800 }}" loading="lazy" li-object:alt="product.featured_image.alt | default: product.title" li-object:src="product.featured_image | image_url: width: 800, height: 800" class="product-item_image"></a></div><div class="product-item_content-wrapper"><div class="product-item_heading"><a li-object:href="product.url" href="{{ product.url }}" class="product-item_text-link w-inline-block"><div class="product-item_left"><div li-object="product.title" class="product_item-name">{{ product.title }}</div></div><div class="product-item_price"><div li-object="product.price | money">{{ product.price | money }}</div>{% if product.compare_at_price_max > product.price %}    <div li-if="product.compare_at_price_max > product.price">
