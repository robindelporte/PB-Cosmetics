  background-color: var(--_primitives---colors--white);
  color: var(--_primitives---colors--noir);
  text-align: center;
  text-transform: uppercase;
  padding: .5rem 2rem;
  font-size: 1.25rem;
  line-height: 1;
  text-decoration: none;
  transition: all .3s;
  position: relative;
  overflow: hidden;
}

.button-3:hover {
  border-color: var(--_primitives---colors--noir-profond);
  color: var(--_primitives---colors--white);
  --_etat---on: 0;
  --_etat---off: 1;
  font-weight: 400;
}

.tabs_panel {
  grid-column-gap: 3.125rem;
  grid-row-gap: 3.125rem;
  flex-flow: column;
  justify-content: flex-start;
  align-items: center;
  display: flex;
}

.tabs_panel-content {
  flex-flow: column;
  grid-template-rows: auto auto;
  grid-template-columns: 1fr 1fr;
  grid-auto-columns: 1fr;
  align-self: stretch;
  display: flex;
}

.tab-button_stroke {
  background-color: var(--_primitives---colors--noir-profond);
  height: 2px;
  width: calc(40% * var(--_etat---off));
  transition-property: all;
  transition-duration: .2s;
  transition-timing-function: ease;
  position: absolute;
  inset: auto auto -.3125rem 50%;
  transform: translate(-50%);
}

